{
  "name": "dsh-helper-plugin-command-ask",
  "version": "0.2.0",
  "description": "dsh plugin: a Cursor-style /ask mode for DeepSeek Harness (dsh) — read-only Q&A for one turn, with an enforced read-only tool guard and durable state folded from the /ask command records. Installs via link: or github:.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cursor",
    "ask-mode",
    "read-only",
    "slash-command",
    "cordis",
    "turn-scoped",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x102201/dsh-helper-plugin-command-ask.git"
  },
  "bugs": {
    "url": "https://github.com/x102201/dsh-helper-plugin-command-ask/issues"
  },
  "homepage": "https://github.com/x102201/dsh-helper-plugin-command-ask#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "examples",
    "scripts",
    "test",
    "test-support",
    "README.md",
    "README.zh.md",
    "VERIFICATION.md",
    "VERIFICATION.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:direct": "node scripts/run-tests.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": false
}
